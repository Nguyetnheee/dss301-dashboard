# Public URL for the external Python prediction service. Vite injects this at build time.
# The service must accept POST { records: [...] } and allow this Vercel origin with CORS.
MODEL_API_URL=https://your-python-model-service.example.com/predict

# Do not put MODEL_API_KEY in this static Vite application. Keep credentials in the
# prediction service or introduce a server-side proxy before authentication is required.
